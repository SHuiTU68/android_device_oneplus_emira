service powermodel-hal-aidl /odm/bin/hw/vendor.oplus.hardware.powermodel-service
    class hal
    user root
    group root readproc system
    capabilities SYS_NICE
    interface aidl vendor.oplus.hardware.powermodel.IPowerModel/default
    disabled
    oneshot
